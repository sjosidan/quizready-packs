      "cards": [
        {
          "id": "curious-world:card:river",
          "q": "Which river flows through Cairo?",
          "a": "The Nile",
          "accept": "Nile",
          "tags": [
            "geography"
          ]
        },
        {
          "id": "curious-world:card:planet",
          "q": "Which planet is known for its prominent ring system?",
          "a": "Saturn",
          "tags": [
            "science",
            "space"
          ]
        },
        {
          "id": "curious-world:card:water",
          "q": "Which two chemical elements make up water?",
          "a": "Hydrogen and oxygen",
          "accept": "ordered: hydrogen + oxygen",
          "tags": [
            "science"
          ]
        },
        {
          "id": "curious-world:card:japan",
          "q": "What is the capital of Japan?",
          "a": "Tokyo",
          "tags": [
            "geography"
          ]
        },
        {
          "id": "curious-world:card:photosynthesis",
          "q": "Which gas do plants absorb for photosynthesis?",
          "a": "Carbon dioxide",
          "accept": "CO2",
          "tags": [
            "science"
          ]
        },
        {
          "id": "curious-world:card:australia",
          "q": "What is the largest city in Australia by population?",
          "a": "Sydney",
          "hint": "It is not the capital.",
          "tags": [
            "geography"
          ]
        },
        {
          "id": "curious-world:card:heart",
          "q": "How many chambers does a typical human heart have?",
          "a": "Four",
          "accept": "4",
          "tags": [
            "science",
            "body"
          ]
        },
        {
          "id": "curious-world:card:equator",
          "q": "What is the name of the imaginary line at zero degrees latitude?",
          "a": "The Equator",
          "accept": "Equator",
          "tags": [
            "geography"
          ]
        }
